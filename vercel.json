{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{tests/**,scripts/**,instance/**,docker-compose.yml,requirements-dev.txt,.venv/**,.pytest_cache/**,**/__pycache__/**}",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
