# Copy this file to .env and fill in real values before running the app.

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# PostgreSQL connection
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://suren_user:suren_pass@localhost:5432/suren_pastries

# Used only by scripts/seed.py the first time you set up the admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Needed once the frontend is split out to GitHub Pages — set this to your
# Pages URL, no trailing slash, e.g. https://your-username.github.io
FRONTEND_ORIGIN=http://localhost:5000

# Render sets this automatically in its environment — leave unset locally.
# RENDER=true
