# Production DATABASE_URL must use the Supabase pooler (transaction mode, port 6543).
# Run `flask db-upgrade` separately with the Supabase direct URL (port 5432).
# Vercel requires a SECRET_KEY of at least 32 bytes.
DATABASE_URL=
SECRET_KEY=
# Upstash Redis URL (rediss://...) used for shared production rate-limit storage.
REDIS_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_KEY=
ADMIN_TOTP_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FRONTEND_ORIGIN=http://localhost:5000
PUBLIC_SITE_URL=
PERF_LOG=0
PERF_SLOW_QUERY_MS=100
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=suren_pastries
POSTGRES_PORT=5432
# Local testing only: authenticates customer login/signup without phone OTP.
# The app refuses to start if this is enabled in production.
CUSTOMER_OTP_TEST_BYPASS=false
